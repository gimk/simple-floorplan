{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate:local": "npx wrangler d1 migrations apply simple-floorplan --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply simple-floorplan --remote",
    "dev:api": "npm run build && npx wrangler dev --port 8788",
    "deploy": "npm run build && npx wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "sfp": "node cli/sfp.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "pdfjs-dist": "^6.5.438",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
